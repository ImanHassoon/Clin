# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://clin:clin@localhost:5432/clin?schema=public"

PORT=4000
NODE_ENV=development

# Use long, random, distinct secrets in real environments.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed mobile app / web origins.
CORS_ORIGINS="http://localhost:19006"

# Local disk storage adapter (dev only). Swap for the S3 adapter in prod.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=15
